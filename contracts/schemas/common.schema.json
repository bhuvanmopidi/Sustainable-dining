{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainable-dining.local/schemas/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },

    "meal_type":     { "enum": ["BREAKFAST", "LUNCH", "DINNER"] },
    "phase":         { "enum": ["BASELINE", "WARMUP", "ADAPTIVE"] },
    "policy_label":  { "enum": ["P0", "P1", "P2", "P3"] },
    "item_role":     { "enum": ["ELIGIBLE", "FIXED"] },
    "rec_source":    { "enum": ["BASELINE", "WARMUP", "LEARNER", "ROLLBACK"] },
    "eval_status":   { "enum": ["OK", "EXCLUDED_ZERO_ATTENDANCE", "REFERENCE_INCOMPLETE"] },
    "safety_rule":   { "enum": ["WASTE_SPIKE", "WASTE_SUSTAINED", "UPTAKE_DROP", "UPTAKE_SUSTAINED"] },
    "safety_action": { "enum": ["ROLLBACK", "ALERT_ONLY"] },
    "reason_code": {
      "enum": ["BASELINE_NEUTRAL", "WARMUP_ROUND_ROBIN", "HIGHEST_UCB", "FORCED_P0_ROLLBACK", "SINGLE_LAYOUT_ONLY",
               "ALL_ALTERNATIVES_COOLING_DOWN"]
    },

    "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "non_negative": { "type": "number", "minimum": 0 },

    "per_meal_type_number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BREAKFAST", "LUNCH", "DINNER"],
      "properties": {
        "BREAKFAST": { "type": "number" },
        "LUNCH": { "type": "number" },
        "DINNER": { "type": "number" }
      }
    },

    "meal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "meal_type", "date", "expected_attendance", "enrolled"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "meal_type": { "$ref": "#/$defs/meal_type" },
        "date": { "$ref": "#/$defs/date" },
        "expected_attendance": { "type": "integer", "minimum": 0 },
        "enrolled": { "type": "integer", "minimum": 1 }
      }
    },

    "menu_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dish_id", "category", "role", "standard_slot",
                   "carbon_score", "carbon_factor_snapshot", "portion_mass_snapshot"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "dish_id": { "$ref": "#/$defs/uuid" },
        "category": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/item_role" },
        "standard_slot": { "type": "integer", "minimum": 1 },
        "carbon_score": { "$ref": "#/$defs/fraction" },
        "carbon_factor_snapshot": { "$ref": "#/$defs/non_negative" },
        "portion_mass_snapshot": { "type": "number", "exclusiveMinimum": 0 }
      }
    },

    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_index", "visibility", "eligible_slot"],
      "properties": {
        "slot_index": { "type": "integer", "minimum": 1 },
        "visibility": { "$ref": "#/$defs/fraction" },
        "eligible_slot": { "type": "boolean" }
      }
    },

    "phi": {
      "description": "Feature vector, order fixed by contracts/feature_schema.v1.json",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 16,
      "maxItems": 16
    },

    "ordering": {
      "description": "Menu-item ids in eligible-slot order (most visible first)",
      "type": "array",
      "items": { "$ref": "#/$defs/uuid" },
      "minItems": 0,
      "uniqueItems": true
    },

    "item_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["menu_item_id", "portions_taken", "waste_g"],
      "properties": {
        "menu_item_id": { "$ref": "#/$defs/uuid" },
        "portions_taken": { "type": "integer", "minimum": 0 },
        "waste_g": {
          "description": "Per-dish waste. null unless genuinely measured; never estimated from the mixed bin.",
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },

    "observation": {
      "description": "Only fields a real manager could observe. The simulator must return exactly this shape.",
      "type": "object",
      "additionalProperties": false,
      "required": ["actual_attendance", "aggregate_waste_g", "item_outcomes"],
      "properties": {
        "actual_attendance": { "type": "integer", "minimum": 0 },
        "aggregate_waste_g": { "$ref": "#/$defs/non_negative" },
        "item_outcomes": { "type": "array", "items": { "$ref": "#/$defs/item_outcome" } }
      }
    },

    "reference_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fitted_on_meal_ids", "params", "s_c", "s_w",
                   "mu_log_waste", "sigma_log_waste"],
      "properties": {
        "version": { "type": "string" },
        "fitted_on_meal_ids": { "type": "array", "items": { "$ref": "#/$defs/uuid" }, "minItems": 1, "uniqueItems": true },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uptake", "category_means", "shrinkage_k", "w_ref_g"],
          "properties": {
            "uptake": {
              "description": "Shrunk neutral portions per attendee for each dish x meal type",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["dish_id", "meal_type", "rate", "n_obs"],
                "properties": {
                  "dish_id": { "$ref": "#/$defs/uuid" },
                  "meal_type": { "$ref": "#/$defs/meal_type" },
                  "rate": { "$ref": "#/$defs/non_negative" },
                  "n_obs": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "category_means": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["category", "meal_type", "rate"],
                "properties": {
                  "category": { "type": "string" },
                  "meal_type": { "$ref": "#/$defs/meal_type" },
                  "rate": { "$ref": "#/$defs/non_negative" }
                }
              }
            },
            "shrinkage_k": { "$ref": "#/$defs/non_negative" },
            "w_ref_g": { "$ref": "#/$defs/per_meal_type_number" }
          }
        },
        "s_c": { "type": "number", "exclusiveMinimum": 0 },
        "s_w": { "type": "number", "exclusiveMinimum": 0 },
        "mu_log_waste": { "$ref": "#/$defs/per_meal_type_number" },
        "sigma_log_waste": { "$ref": "#/$defs/per_meal_type_number" }
      }
    },

    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carbon_per_attendee", "waste_g_per_attendee", "log_waste", "eligible_uptake",
                   "total_portions_per_attendee", "c_ref", "w_ref", "uptake_ref",
                   "z_c", "z_w", "reward_unclipped", "reward"],
      "properties": {
        "carbon_per_attendee": { "type": ["number", "null"], "minimum": 0 },
        "waste_g_per_attendee": { "type": ["number", "null"], "minimum": 0 },
        "log_waste": { "type": ["number", "null"], "minimum": 0 },
        "eligible_uptake": { "type": ["number", "null"], "minimum": 0 },
        "total_portions_per_attendee": { "type": ["number", "null"], "minimum": 0 },
        "c_ref": { "type": ["number", "null"], "minimum": 0 },
        "w_ref": { "type": ["number", "null"], "minimum": 0 },
        "uptake_ref": { "type": ["number", "null"], "minimum": 0 },
        "z_c": { "type": ["number", "null"] },
        "z_w": { "type": ["number", "null"] },
        "reward_unclipped": { "type": ["number", "null"] },
        "reward": { "type": ["number", "null"], "minimum": -3, "maximum": 3 }
      }
    }
  }
}
