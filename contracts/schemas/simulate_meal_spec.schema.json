{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainable-dining.local/schemas/simulate_meal_spec.schema.json",
  "title": "POST /simulate/meal-spec (demo service only)",
  "description": "Meal, menu and serving line for one simulated meal. Contains only what a real manager would plan in advance.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "scenario",
        "meal_index"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "scenario": {
          "$ref": "simulate_outcome.schema.json#/$defs/request/properties/scenario"
        },
        "meal_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meal_index",
        "n_meals",
        "meal",
        "menu_items",
        "slots",
        "catalogue_median_carbon_score",
        "dish_names"
      ],
      "properties": {
        "meal_index": {
          "type": "integer",
          "minimum": 0
        },
        "n_meals": {
          "type": "integer",
          "minimum": 1
        },
        "meal": {
          "$ref": "common.schema.json#/$defs/meal"
        },
        "menu_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/menu_item"
          }
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/slot"
          }
        },
        "catalogue_median_carbon_score": {
          "$ref": "common.schema.json#/$defs/fraction"
        },
        "dish_names": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
